[Unit]
Description=SGW-Admin: tägliches Backup der App-Datenbank
Documentation=file:///root/sgw-admin/admin/README.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /root/sgw-admin/admin/ops/backup_db.sh
UMask=0077
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
